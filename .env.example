# Cloudflare tunnel token for the `home-server` tunnel.
# Get a fresh one from: Cloudflare Zero Trust → Networks → Tunnels → home-server → Edit → Connectors (Docker tab) → token in --token flag
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: Slack incoming-webhook URL — pings when someone submits a repo/demo access request.
# Leave empty to disable notifications (requests still land in the naukri app).
SLACK_WEBHOOK_URL=
